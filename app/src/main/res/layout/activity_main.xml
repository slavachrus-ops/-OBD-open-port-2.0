<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статус: Адаптер не подключен"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Найти и инициализировать OpenPort 2.0" />

    <Button
        android:id="@+id/btnCheckObdPower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Проверить питание OBD (Пин 16 +12V / Масса)"
        android:enabled="false" />

    <Button
        android:id="@+id/btnTestCan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Тест шины CAN (Пины 6 и 14 — 500 kbps)"
        android:enabled="false" />

    <Button
        android:id="@+id/btnTestKline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Тест линии K-Line (Пин 7 — ISO9141)"
        android:enabled="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Журнал обмена данными (USB Bulk):"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:text="Ожидание подключения OpenPort 2.0 по USB OTG...\n" />
    </ScrollView>
</LinearLayout>
